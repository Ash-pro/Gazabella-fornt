meta {
  name: Cart — View
  type: http
  seq: 2
}

get {
  url: {{base_url}}/cart
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Guest-UUID: {{guest_uuid}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has items", function() {
    expect(res.body.data).to.have.property("items");
  });
  test("has subtotal", function() {
    expect(res.body.data).to.have.property("subtotal");
  });
}
