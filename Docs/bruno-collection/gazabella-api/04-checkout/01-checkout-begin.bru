meta {
  name: Checkout Begin (Extend Reservation)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/orders/checkout/begin
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Guest-UUID: {{guest_uuid}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has delivery_options", function() {
    expect(res.body.data.delivery_options).to.be.an("array");
  });
  test("has reservation_expires_at", function() {
    expect(res.body.data).to.have.property("reservation_expires_at");
  });
  test("has subtotal", function() {
    expect(res.body.data).to.have.property("subtotal");
  });
}
