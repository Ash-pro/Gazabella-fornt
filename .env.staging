# ═══════════════════════════════════════════════════════════════
# Staging — P1-FE-01 · يُستخدم مع: npm run build:staging  (vite --mode staging)
# على Vercel: تُضبط نفس المتغيرات من Settings → Environment Variables (Preview)
# وقيم Vercel تتقدّم على هذا الملف. لا أسرار هنا — كل VITE_* تظهر في المتصفح.
# ═══════════════════════════════════════════════════════════════
VITE_DATA_SOURCE=api
# الباك اند (فرع development) يعمل بعقد legacy: /cart/items و/checkout — مسارات mvp0 غير موجودة (تحقق 13/10/2026)
VITE_API_CONTRACT=legacy

# يُستبدل برابط Staging الحقيقي عند جاهزيته (P1-BE-02 — عاصم)
VITE_API_BASE_URL=https://staging-api.gazabella.ps/api/v1
VITE_STORAGE_URL=https://staging-api.gazabella.ps

# شريط أعلى الواجهة — يُحذف/يُترك فارغاً في الإنتاج
VITE_ENV_LABEL=بيئة تجريبية — لا تُنفَّذ طلبات حقيقية

# Reverb — فارغ حتى P3 (الواجهة تعمل بالتحديث الدوري)
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_HOST=
# VITE_PUSHER_PORT=443
# VITE_PUSHER_SCHEME=https

VITE_SUPPORT_WHATSAPP=
VITE_POLICIES_APPROVED=false
VITE_SITE_URL=https://staging.gazabella.ps
VITE_SENTRY_DSN=
VITE_ANALYTICS_PROVIDER=none

# R-1 وضع العرض التجريبي: يملأ ميزات المرحلة 1+ (التقييمات، التبويبات…) ببيانات موسومة «عرض تجريبي» عند غياب الـ API.
# ممنوع true في الإنتاج عند الإطلاق (Docs/STOREFRONT_ROADMAP_AR.md).
VITE_DEMO_FIXTURES=true
# P1-4 «نبّهيني لما يتوفر» على الإنتاج: true بعد جاهزية POST /products/{slug}/stock-alerts
VITE_STOCK_ALERTS=false
