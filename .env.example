# =======================================================================
# إعدادات مصدر البيانات (Data Source Configuration)
# =======================================================================
# اختر 'mock' لتشغيل الموقع بداتا وهمية تفاعلية وتصميم كامل
# اختر 'api' للربط مع خادم الـ API الحقيقي
VITE_DATA_SOURCE=api

# رابط الـ API الحقيقي (يُستخدم عندما يكون VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=https://gazabella-development-kvxf3t.laravel.cloud/api/v1

# رابط Storage للصور
VITE_STORAGE_URL=https://gazabella-development-kvxf3t.laravel.cloud

# محاكاة زمن استجابة الشبكة للبيانات الوهمية (بالملي ثانية)
VITE_MOCK_DELAY_MS=250

VITE_API_CONTRACT=legacy
# npm run dev:mvp0 يشغل الخادم المحلي بالعقد المنفصل.

# =======================================================================
# التحديث اللحظي — Laravel Reverb (P3 · G-03 · C-P1-03)
# =======================================================================
# اتركها فارغة: الواجهة تعمل بالتحديث الدوري كل 30 ثانية (الوضع الحالي).
# عند تشغيل Reverb على الخادم تُضبط القيم فيتفعّل الاشتراك تلقائياً.
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_HOST=127.0.0.1
# VITE_PUSHER_PORT=8080
# VITE_PUSHER_SCHEME=http
# اختياري — افتراضياً {أصل VITE_API_BASE_URL}/broadcasting/auth
# VITE_BROADCAST_AUTH_URL=

# =======================================================================
# الدعم والسياسات (Launch)
# =======================================================================
# رقم واتساب الدعم (دولي أو محلي: 0599… يتحول تلقائياً إلى 970…)
# الأولوية لـ social_links.whatsapp من /settings في الباك اند.
VITE_SUPPORT_WHATSAPP=
# true بعد اعتماد نصوص السياسات والقيم في src/content/storeInfo.ts (يخفي شارة «نسخة أولية»)
VITE_POLICIES_APPROVED=false

# =======================================================================
# SEO — الرابط العام للموقع (canonical · og:url · og:image)
# =======================================================================
VITE_SITE_URL=https://gazabella.ps
# middleware.ts (Vercel Runtime env — ليست VITE_):
# SITE_URL=https://gazabella.ps
# OG_API_BASE_URL=https://api.gazabella.ps/api/v1
# OG_STORAGE_URL=https://api.gazabella.ps

# =======================================================================
# مراقبة الأخطاء — Sentry (فارغ = معطّل)
# =======================================================================
VITE_SENTRY_DSN=
# نسبة تتبع الأداء 0..1 (0 = أخطاء فقط، يوفّر الحصة المجانية)
VITE_SENTRY_TRACES_RATE=0

# =======================================================================
# Analytics — none | plausible | ga4 (لا بيانات شخصية في أي حدث)
# =======================================================================
VITE_ANALYTICS_PROVIDER=none
VITE_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
VITE_GA4_ID=
# true لطباعة الأحداث في console (تلقائي في dev)
VITE_ANALYTICS_DEBUG=false
