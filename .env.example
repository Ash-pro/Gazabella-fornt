# =======================================================================
# إعدادات مصدر البيانات (Data Source Configuration)
# =======================================================================
# اختر 'mock' لتشغيل الموقع بداتا وهمية تفاعلية وتصميم كامل
# اختر 'api' للربط مع خادم الـ API الحقيقي
VITE_DATA_SOURCE=mock

# رابط الـ API الحقيقي (يُستخدم عندما يكون VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# محاكاة زمن استجابة الشبكة للبيانات الوهمية (بالملي ثانية)
VITE_MOCK_DELAY_MS=250

# إعدادات Laravel Reverb (WebSockets للأحداث المباشرة)
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=gazabella-key

